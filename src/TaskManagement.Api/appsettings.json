{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost,1433;Database=TaskManagementDb;User Id=sa;Password=Your_password123;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },
  "Jwt": {
    "Issuer": "TaskManagement.Api",
    "Audience": "TaskManagement.Client",
    "SigningKey": "REPLACE_ME_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS_FOR_LOCAL_DEV_ONLY",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 14
  },
  "Email": {
    "Mode": "PickupDirectory",
    "FromAddress": "noreply@taskmgmt.local",
    "FromName": "Task Management",
    "Host": "localhost",
    "Port": 25,
    "UseSsl": false,
    "PickupPath": "./mail-pickup"
  },
  "FileStorage": {
    "Root": "./uploads",
    "MaxFileSizeBytes": 26214400
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "https://localhost:4200"
    ]
  }
}
