# Copy this file to .env and override values for your environment.
# docker compose reads .env automatically.

# ASP.NET Core environment: Development | Staging | Production
ASPNETCORE_ENVIRONMENT=Development

# SQL Server (used by the db, api, and api-seed services)
DB_PORT=1433
DB_PASSWORD=Your_password123

# JWT — MUST be at least 32 characters in production
JWT_SIGNING_KEY=CHANGE_ME_dev_only_signing_key_at_least_32_chars

# Host port mappings
API_PORT=5080
WEB_PORT=4200
